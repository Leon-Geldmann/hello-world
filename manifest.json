{
  "manifest_version": 3,
  "name": "Price Converter - Gold, Silver & Crypto",
  "version": "2.0.0",
  "description": "Shows gold, silver, Bitcoin, Ethereum and more price equivalents below product prices on any webpage. Updates every minute.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.coingecko.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["constants.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
